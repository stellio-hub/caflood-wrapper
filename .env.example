# Configuration of the CAFLOOD service scripts (see caflood_common.py).
# Copy to .env next to the scripts and fill in real values - never commit a
# filled-in copy. Real environment variables take priority over this file.

# --- Stellio broker + Keycloak client (all scripts) --------------------------
STELLIO_BASE_URL=https://stellio-dev.eglobalmark.com
STELLIO_TOKEN_URL=https://sso.eglobalmark.com/auth/realms/stellio-dev/protocol/openid-connect/token
STELLIO_CLIENT_ID=nifi
STELLIO_CLIENT_SECRET=changeme
STELLIO_CONTEXT_URL=https://easy-global-market.github.io/ngsild-api-data-models/twinPicks/jsonld-contexts/twinPicks-compound.jsonld
STELLIO_TENANT=urn:ngsi-ld:tenant:default

# --- File storage: NiFi S3 storage endpoint (DEM fetch, results upload) ----
# Authenticated with the STELLIO_* credentials above.
FILE_STORAGE_URL=https://dataflow.stellio.io/dev/storage
FILE_STORAGE_OUTPUT_BUCKET=urbaquantum-caflood-outputs-rasters

# --- Local folders (caflood_build.py) ---------------------------------------
# Where job folders / zips are built.
CAFLOOD_WORK_DIR=caflood_work_dir

# --- CAFLOOD VM over SSH (caflood_poll.py, caflood_publish.py) - defaults ---
CAFLOOD_SSH_TARGET=stellio@82.165.169.218
CAFLOOD_SSH_PORT=41596
CAFLOOD_SSH_KEY=/opt/certs/id_ed25519_caflood_vm
CAFLOOD_SSH_KNOWN_HOSTS=/opt/certs/known_hosts
# One folder per tenant / deployment: a poller handles every run it finds there.
CAFLOOD_RUNS_DIR=/home/stellio/caflood-service-execution
# Reported runs are stripped down to output.log at once, deleted after N days.
CAFLOOD_LOG_RETENTION_DAYS=7
# Reuse one SSH connection for 60 s (avoids the VM's connection rate limit)
CAFLOOD_SSH_MULTIPLEX=1
